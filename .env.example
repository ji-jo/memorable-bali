# Optional — only needed for Google Places reconcile / Photos.
# The Explore map uses OpenFreeMap and does not require a Google key.
GOOGLE_MAPS_API_KEY=

# Unsplash — used ONLY by local Node scripts (scripts/fetch-spot-images.mjs).
# NEVER prefix with VITE_ — that would ship the key in the browser bundle.
# Put this in `.env` or `.env.local` (both gitignored) and paste your Access Key.
# Secret Key / Application ID are not needed for public photo search/download.
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# LocationIQ — Dashboard → API Access Tokens. https://locationiq.com/
# Server/scripts only (scripts/reconcile-spots-locationiq.mjs). Do not prefix VITE_.
LOCATION_IQ_ACCESS_TOKEN=

# Browser stay-search (StayLocationPicker). Same token is OK if you restrict it by
# HTTP referrer in the LocationIQ dashboard (localhost + your production domain).
# Without this, the picker falls back to Nominatim (Bali-bounded).
VITE_LOCATION_IQ_ACCESS_TOKEN=

# Client-side (only if you reintroduce Google Maps JS SDK):
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=
